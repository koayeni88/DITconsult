# DiTconsult environment variables
# Copy to .env.local for local development — never commit .env.local

# Resend email delivery (required for the contact form)
RESEND_API_KEY=

# Where contact form submissions are delivered
CONTACT_EMAIL=support@ditconsult.com

# Verified sender in Resend.
# Until ditconsult.com is verified in Resend, you may use:
#   DiTconsult Contact Form <onboarding@resend.dev>
# Note: Resend's onboarding sender can only deliver to the email on your Resend account
# unless you verify your domain. After verifying ditconsult.com, prefer:
#   DiTconsult Contact Form <notifications@ditconsult.com>
FROM_EMAIL=DiTconsult Contact Form <onboarding@resend.dev>

# Custom server (Hostinger deployment via server.js)
HOSTNAME=localhost
PORT=3000
NODE_ENV=production
