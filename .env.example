# DiTconsult environment variables
# Copy to .env.local for local development — never commit .env.local or .env

# Resend email delivery (required for the contact form)
# Place the real key only in .env.local (local) or the PM2/host environment (production).
RESEND_API_KEY=

# Where contact form submissions are delivered
CONTACT_EMAIL=support@ditconsult.com

# Verified Resend sender on ditconsult.com (domain must be verified with DKIM/SPF).
# Quotes are required — spaces and < > break unquoted shell/PM2 values.
FROM_EMAIL="DITconsult Website <website@ditconsult.com>"

# Custom server (Hostinger deployment via server.js)
HOSTNAME=localhost
PORT=3000
NODE_ENV=production
